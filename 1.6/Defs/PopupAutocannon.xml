<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="VFES_BuildingConcealedBase">
    <defName>VFES_Turret_FloorTurretAutoCannon</defName>
    <label>concealed autocannon turret</label>
    <description>A compact automatic autocannon turret equipped with retractable armor plating and a submersion mechanism. It only takes half as much damage when submerged. Requires steel to refurbish its barrels after heavy use. May explode when damaged.</description>
    <thingClass>VFESecurity.Building_ConcealedTurret</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData Inherit="False">
      <texPath>NewThings/Security/ConcealedTurret/ConcealedTurret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <size>(2,2)</size>
    <techLevel>Industrial</techLevel>
    <uiIconPath>UI/New/TurretFloor_TopAutocannonUI</uiIconPath>
    <uiIconScale>0.90</uiIconScale>
    <minifiedDef>MinifiedThing</minifiedDef>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <costStuffCount>0</costStuffCount>
    <stuffCategories Inherit="False" />
    <costList Inherit="False">
      <Steel>600</Steel>
      <Plasteel>70</Plasteel>
      <ComponentIndustrial>10</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>420</MaxHitPoints>
      <WorkToBuild>21000</WorkToBuild>
      <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
      <Mass>120</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <comps>
      <li Class="VFESecurity.CompProperties_Concealed">
        <submergeSeconds>3</submergeSeconds>
        <deploySeconds>3</deploySeconds>
        <cooldownSeconds>10</cooldownSeconds>
        <submergedGraphic>
          <texPath>NewThings/Security/ConcealedTurret/ConcealedTurret_Concealed</texPath>
          <drawSize>(2,2)</drawSize>
          <graphicClass>Graphic_Single</graphicClass>
        </submergedGraphic>
      </li>
      <li Class="CompProperties_Explosive">
        <wickTicks>240</wickTicks>
        <explosiveRadius>5.9</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Shots until barrel change</fuelLabel>
        <fuelGizmoLabel>Barrel durability</fuelGizmoLabel>
        <outOfFuelMessage>Needs new barrel</outOfFuelMessage>
        <fuelFilter><thingDefs><li>Steel</li></thingDefs></fuelFilter>
        <fuelCapacity>110</fuelCapacity>
        <fuelMultiplier>0.5</fuelMultiplier>  
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
    </comps>
    <passability>PassThroughOnly</passability>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <building>
      <turretGunDef>Gun_AutocannonTurretPopup</turretGunDef>
      <turretTopDrawSize>4</turretTopDrawSize>
      <turretBurstCooldownTime>3.5</turretBurstCooldownTime>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <researchPrerequisites Inherit="False">
      <li>VFES_ConcealedDefenses</li>
      <li>HeavyTurrets</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>Gun_AutocannonTurretPopup</defName>
    <label>autocannon</label>
    <description>A self-loading large-bore cannon designed to attach to a turret.</description>
    <graphicData>
      <texPath>Turrets/New/TurretFloor_TopAutocannon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.28</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.66</AccuracyMedium>
      <AccuracyLong>0.5</AccuracyLong>
      <RangedWeapon_Cooldown>3.5</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>40</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>Bullet_AutocannonTurret</defaultProjectile>
        <warmupTime>0</warmupTime>
        <minRange>8.9</minRange>
        <range>27.9</range>
        <ticksBetweenBurstShots>25</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <soundCast>Shot_Autocannon</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
        <consumeFuelPerShot>1</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>
</Defs>