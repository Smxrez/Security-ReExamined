<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="VFES_BuildingConcealedBase">
    <defName>VFES_Turret_FloorTurretCharge</defName>
    <label>concealed charge turret</label>
    <description>A compact automatic charge turret equipped with retractable armor plating and a submersion mechanism. It only takes half as much damage when submerged. Requires plasteel to refurbish its barrels after heavy use. May explode when damaged.</description>
    <thingClass>VFESecurity.Building_ConcealedTurret</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData Inherit="False">
      <texPath>NewThings/Security/ConcealedTurret/ConcealedTurret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <uiIconPath>UI/New/TurretFloor_TopChargeUI</uiIconPath>
    <uiIconScale>0.90</uiIconScale>
    <minifiedDef>MinifiedThing</minifiedDef>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <costStuffCount>0</costStuffCount>
    <stuffCategories Inherit="False" />
    <costList Inherit="False">
      <Plasteel>85</Plasteel>
      <ComponentSpacer>1</ComponentSpacer>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>275</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <ShootingAccuracyTurret>0.965</ShootingAccuracyTurret>
      <Mass>12</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <comps Inherit="False">
      <li Class="VFESecurity.CompProperties_Concealed">
        <submergeSeconds>1</submergeSeconds>
        <deploySeconds>1</deploySeconds>
        <cooldownSeconds>10</cooldownSeconds>
        <submergedGraphic>
          <texPath>NewThings/Security/ConcealedTurret/ConcealedTurret_Concealed</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </submergedGraphic>
      </li>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>3.9</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>125</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Shots until barrel change</fuelLabel>
        <fuelGizmoLabel>Barrel durability</fuelGizmoLabel>
        <fuelFilter><thingDefs><li>Plasteel</li></thingDefs></fuelFilter>
        <fuelCapacity>40</fuelCapacity>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <fuelMultiplier>1</fuelMultiplier>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <outOfFuelMessage>Needs new barrel</outOfFuelMessage>
        <fuelIconPath>UI/Overlays/PlasteelBarrel</fuelIconPath>
      </li>
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs>
          <li>Stun</li>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
    <passability>PassThroughOnly</passability>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <building>
      <turretGunDef>VFES_Gun_ChargeTurretPopup</turretGunDef>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <researchPrerequisites Inherit="False">
      <li>VFES_ConcealedDefenses</li>
      <li>ChargedShot</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>VFES_Gun_ChargeTurretPopup</defName>
    <label>charged turret gun</label>
    <description>A charge rifle made to be mounted on a turret.</description>
    <graphicData>
      <texPath>Turrets/New/TurretFloor_TopCharge</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <destroyOnDrop>true</destroyOnDrop>
    <tradeability>None</tradeability>
    <useHitPoints>false</useHitPoints>
    <statBases>
      <AccuracyTouch>0.8</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.45</AccuracyLong>
      <RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>4.6</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <weaponTags Inherit="false">
      <li>TurretGun</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>VFES_Bullet_ChargeTurretShot</defaultProjectile>
        <range>20.9</range>
        <ticksBetweenBurstShots>15</ticksBetweenBurstShots>
        <burstShotCount>4</burstShotCount>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <consumeFuelPerShot>1</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>
</Defs>